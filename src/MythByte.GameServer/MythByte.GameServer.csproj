<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MythByte.Application\MythByte.Application.csproj" />
    <ProjectReference Include="..\MythByte.Infrastructure\MythByte.Infrastructure.csproj" />
    <ProjectReference Include="..\MythByte.Networking\MythByte.Networking.csproj" />
    <ProjectReference Include="..\MythByte.Shared\MythByte.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\MythByte.Client\Content\Maps\**\*.tmj" Link="Content\Maps\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MythByte.Client\Content\Tilesets\**\*.tsj" Link="Content\Tilesets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
